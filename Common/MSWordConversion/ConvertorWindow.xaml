<Window x:Class="CodeEditor.ConvertorWindow" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:CodeEditor;assembly=CodeBox" 
        Title="Code Generator" >
    <Grid Name="windowGrid" Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="450" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="500*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="26"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <GridSplitter Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="Black" ShowsPreview="true" Width="2"/>
        <StackPanel Grid.Column="0" Orientation="Horizontal" Background="LightGray">
            <Label Content="Equation vatiable" />
            <TextBox x:Name="eqVarBox" Text="t" Margin="2" Width="20"/>
            <Label Content="Functions" />
            <TextBox x:Name="functionBox" Text="" Margin="2" Width="260" />
        </StackPanel>
        <StackPanel x:Name="convertionPanel" Grid.Column="2" Background="LightGray" HorizontalAlignment="Stretch" Orientation="Horizontal">
            <Label Content="Convert to" />
            <ComboBox x:Name="conversionCombo" Margin="2" Width="135" Background="#FFECE7E7" BorderBrush="Black" SelectedIndex="0" />
        </StackPanel>
        <Border Grid.Column="2" Grid.Row="1" Background="Black" Margin="3,0,0,0">
            <c:CodeBox  x:Name="codeBox" LineNumberMarginWidth="25" Foreground="Transparent"/>
        </Border>
        <Border Grid.Column="0" Grid.Row="1" Background="Black">
            <TextBox  x:Name="sourceBox" Background="#FFEFEFEF" TextWrapping="Wrap" AcceptsReturn="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"/>
        </Border>
    </Grid>
</Window>
